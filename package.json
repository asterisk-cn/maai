    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "wrangler": "^4.142.0"
  },
  "packageManager": "pnpm@10.32.1"
}
